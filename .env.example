# ===== 服务 =====
# 监听端口（默认 9221）
PORT=9221
# 监听地址（默认 127.0.0.1 仅本机访问；如需局域网访问改为 0.0.0.0，并务必保持 API_KEY 开启）
HOST=127.0.0.1

# ===== API Key（客户端调用凭据）=====
# 留空（推荐）：首次启动自动生成 sk-qw- 开头的随机 Key，
#   保存到 ~/.qwen-api/api-key.json，并在控制台打印，删除该文件即可重新生成。
# 手动填写：客户端必须携带 Authorization: Bearer <该值>
API_KEY=
# 设为 1 完全关闭鉴权（仅建议在完全可信的本机环境使用）
QW_ALLOW_NO_KEY=0

# ===== 千问办公 (QwenWorkCN) =====
# 上游网关（默认 https://gateway.qwenwork.cn，一般无需修改）
QW_GATEWAY=https://gateway.qwenwork.cn
# 签名模块 wasm 路径（默认使用仓库内置副本，一般无需修改）
QW_WASM_PATH=
# 千问办公桌面端数据目录（含 auth-v2.dat，默认 %APPDATA%\QwenWorkCN）
QW_APPDATA=
# CLI 主目录（含 machine-id 与加密模型目录，默认 %USERPROFILE%\.qwenworkcn）
QW_CLI_HOME=
# 手动覆盖机器码（默认读取 QW_CLI_HOME\machine-id）
QW_MACHINE_ID=
# 手动覆盖账号 uid（默认自动从 auth-v2.dat 解密；仅在未安装桌面端时需要）
QW_UID=
# 手动 Bearer token（仅用于积分查询，推理不需要；默认自动获取）
QW_TOKEN=
# 手动 refresh token（仅积分查询 401 时自动刷新用；默认自动获取）
QW_REFRESH_TOKEN=
# 默认模型（pro | flash | qwen3.8-max-preview，默认 pro）
QW_DEFAULT_MODEL=pro
# 上报的 cosy 版本（默认 1.1.32）
QW_CLI_VERSION=1.1.32
# 数据目录（API Key 与 token 缓存，默认 ~/.qwen-api）
QW_DATA_DIR=
